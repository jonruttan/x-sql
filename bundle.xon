; bundle.xon -- what this bundle is.

(name "sql")

; Self-contained: this bundle depends on nothing but the platform.
;
; Neon: helium with the compiler and the Lexer, so this bundle's own source
; is tokenized through native code from its first byte, and no syntax or
; library it did not ask for.  The numeric tower is an import: an integer
; wider than a machine word is a HUGEINT, not a wrapped number.
(dialect ne)

(requires-release "v0.62.0")

; `x -l sql` boots the module sql/run.
(entry run)

; The SQL grammar, for any process that colours a file: sql/syntax imports
; x-lang libraries and sql/words only.
(grammar sql (module sql/syntax) (files ".sql"))
