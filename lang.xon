; lang.xon -- what this bundle is.

(lang "sql")

; Self-contained: this bundle depends on nothing but the platform.
;
; Helium, plus exactly the libraries this bundle imports and nothing
; ambient.  The numeric tower is one of them: an integer wider than a
; machine word is a HUGEINT, not a wrapped number.
(dialect he)

(requires-release "v0.55.0")

(entry "run.x")
